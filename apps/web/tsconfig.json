{
	"extends": "../../tsconfig.base.json",
	"compilerOptions": {
		"target": "ES2020",
		"useDefineForClassFields": true,
		"lib": ["DOM", "DOM.Iterable", "ES2020"],
		"allowJs": false,
		"skipLibCheck": true,
		"module": "ESNext",
		"isolatedModules": true,
		"moduleResolution": "Bundler",
		"allowImportingTsExtensions": true,
		"noEmit": true,
		"jsx": "react-jsx",
		"types": ["vite/client"]
	},
	"include": ["src"],
	"references": []
}
